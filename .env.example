# IP of the Sonos speaker/group coordinator this bridge should control.
SONOS_DEVICE_IP=192.168.1.50

# Must be the IP of THIS host/container, reachable by Sonos on the LAN.
# Used to build the audio URLs Sonos is told to fetch.
SERVER_ENDPOINT=http://192.168.1.60:3000

# Same IP as above, used by docker-compose.yml (${HOST_IP}) to pin
# sonos-watcher's SSDP discovery to the real LAN NIC. See its README section.
HOST_IP=192.168.1.60

LOG_LEVEL=info
YT_PLAYER_BRAND=My Home
YT_PLAYER_NAME=Sonos Bridge
